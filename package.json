{
  "name": "moyi-gomoku",
  "version": "1.1.0",
  "description": "墨弈五子棋 · 一个现代、可扩展的 Electron 五子棋游戏",
  "main": "./out/main/index.js",
  "author": "li chuyan",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "pnpm run build && electron-builder --dir",
    "dist:linux": "pnpm run build && electron-builder --linux AppImage --publish never",
    "dist:win": "pnpm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
